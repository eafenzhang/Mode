      "timeoutMs": null,
      "output": "noise\u0000__MODE_LOGIN_ENV_START__\u0000FROM_SHELL=2\u0000__MODE_LOGIN_ENV_END__\u0000",
      "expected": {
        "resolvedShell": "<root>/shell/myshell",
        "args": [
          "-lc",
          "printf '%s\\0' '__MODE_LOGIN_ENV_START__'; env -0; printf '%s\\0' '__MODE_LOGIN_ENV_END__'"

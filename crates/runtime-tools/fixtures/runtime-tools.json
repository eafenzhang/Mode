{
  "platform": "win32",
  "arch": "x64",
  "cases": [
    {
      "name": "runtime-root",
      "cwd": "ws",
      "toolIds": [
        "ripgrep"
      ],
      "env": {
        "MODE_SERVER_RUNTIME_ROOT": "<root>/runtime"
      },
      "setup": [
        "runtime/tools/ripgrep/rg.exe"
      ],
      "expected": {
        "MODE_RG_BINARY": "<root>\\runtime\\tools\\ripgrep\\rg.exe",
        "PATH": "<root>\\runtime\\tools\\ripgrep"
      }
    },
    {
      "name": "cwd-bundled-tools",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {},
      "setup": [
        "ws/bundled-tools/win32-x64/bfs/bfs.exe"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\ws\\bundled-tools\\win32-x64\\bfs\\bfs.exe",
        "PATH": "<root>\\ws\\bundled-tools\\win32-x64\\bfs"
      }
    },
    {
      "name": "packages-desktop-bundled-tools",
      "cwd": "ws",
      "toolIds": [
        "ugrep"
      ],
      "env": {},
      "setup": [
        "ws/packages/desktop/bundled-tools/win32-x64/ugrep/ugrep.exe"
      ],
      "expected": {
        "MODE_UGREP_BINARY": "<root>\\ws\\packages\\desktop\\bundled-tools\\win32-x64\\ugrep\\ugrep.exe",
        "PATH": "<root>\\ws\\packages\\desktop\\bundled-tools\\win32-x64\\ugrep"
      }
    },
    {
      "name": "sibling-desktop-bundled-tools",
      "cwd": "ws",
      "toolIds": [
        "ripgrep"
      ],
      "env": {},
      "setup": [
        "desktop/bundled-tools/win32-x64/ripgrep/rg.exe"
      ],
      "expected": {
        "MODE_RG_BINARY": "<root>\\desktop\\bundled-tools\\win32-x64\\ripgrep\\rg.exe",
        "PATH": "<root>\\desktop\\bundled-tools\\win32-x64\\ripgrep"
      }
    },
    {
      "name": "binary-env-override",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "MODE_BFS_BINARY": " <root>/ws/custom/bfs-bin.exe "
      },
      "setup": [
        "ws/custom/bfs-bin.exe"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>/ws/custom/bfs-bin.exe",
        "PATH": "<root>/ws/custom"
      }
    },
    {
      "name": "invalid-env-falls-back",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "MODE_BFS_BINARY": "<root>/missing/bfs.exe"
      },
      "setup": [
        "ws/bundled-tools/win32-x64/bfs/bfs.exe"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\ws\\bundled-tools\\win32-x64\\bfs\\bfs.exe",
        "PATH": "<root>\\ws\\bundled-tools\\win32-x64\\bfs"
      }
    },
    {
      "name": "path-fallback-default-ext",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "PATH": "<root>/ws/bin"
      },
      "setup": [
        "ws/bin/bfs.EXE"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\ws\\bin\\bfs.EXE",
        "PATH": "<root>/ws/bin;<root>\\ws\\bin"
      }
    },
    {
      "name": "path-fallback-pathext",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "PATH": "<root>/ws/bin",
        "PATHEXT": ".CMD"
      },
      "setup": [
        "ws/bin/bfs.CMD"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\ws\\bin\\bfs.CMD",
        "PATH": "<root>/ws/bin;<root>\\ws\\bin"
      }
    },
    {
      "name": "path-dedupe",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "PATH": "<root>/ws/bin;<root>/ws/bundled-tools/win32-x64/bfs"
      },
      "setup": [
        "ws/bundled-tools/win32-x64/bfs/bfs.exe"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\ws\\bundled-tools\\win32-x64\\bfs\\bfs.exe",
        "PATH": "<root>/ws/bin;<root>/ws/bundled-tools/win32-x64/bfs;<root>\\ws\\bundled-tools\\win32-x64\\bfs"
      }
    },
    {
      "name": "multi-tools",
      "cwd": "ws",
      "toolIds": [
        "bfs",
        "ripgrep",
        "ugrep"
      ],
      "env": {
        "MODE_SERVER_RUNTIME_ROOT": "<root>/runtime"
      },
      "setup": [
        "runtime/tools/bfs/bfs.exe",
        "runtime/tools/ripgrep/rg.exe",
        "runtime/tools/ugrep/ugrep.exe"
      ],
      "expected": {
        "MODE_BFS_BINARY": "<root>\\runtime\\tools\\bfs\\bfs.exe",
        "MODE_RG_BINARY": "<root>\\runtime\\tools\\ripgrep\\rg.exe",
        "MODE_UGREP_BINARY": "<root>\\runtime\\tools\\ugrep\\ugrep.exe",
        "PATH": "<root>\\runtime\\tools\\bfs;<root>\\runtime\\tools\\ripgrep;<root>\\runtime\\tools\\ugrep"
      }
    },
    {
      "name": "none-found",
      "cwd": "ws",
      "toolIds": [
        "bfs"
      ],
      "env": {
        "PATH": "<root>/empty"
      },
      "setup": [],
      "expected": {}
    }
  ],
  "bootstrap": [
    {
      "currentPath": null,
      "expected": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin"
    },
    {
      "currentPath": "/usr/bin:/bin",
      "expected": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin;/usr/bin:/bin"
    },
    {
      "currentPath": "/usr/bin:/bin:/usr/bin",
      "expected": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin;/usr/bin:/bin:/usr/bin"
    },
    {
      "currentPath": "",
      "expected": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin"
    }
  ],
  "login": [
    {
      "name": "explicit-zsh",
      "baseEnv": {
        "PATH": "/custom/bin",
        "TERM": "xterm",
        "FOO": "a=b"
      },
      "shellPath": "/bin/zsh",
      "shellFile": null,
      "timeoutMs": null,
      "output": "noise\u0000__MODE_LOGIN_ENV_START__\u0000PATH=/home/user/.local/bin:/usr/bin\u0000TERM=xterm-256color\u0000EMPTY=\u0000WITH_EQUALS=a=b=c\u0000__MODE_LOGIN_ENV_END__\u0000",
      "expected": {
        "resolvedShell": "/bin/zsh",
        "args": [
          "-ilc",
          "printf '%s\\0' '__MODE_LOGIN_ENV_START__'; env -0; printf '%s\\0' '__MODE_LOGIN_ENV_END__'"
        ],
        "options": {
          "timeout": 4000,
          "maxBuffer": 2097152,
          "env": {
            "PATH": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin;/custom/bin",
            "TERM": "dumb",
            "FOO": "a=b",
            "CI": "1"
          }
        },
        "captured": {
          "PATH": "/home/user/.local/bin:/usr/bin",
          "TERM": "xterm-256color",
          "EMPTY": "",
          "WITH_EQUALS": "a=b=c"
        }
      }
    },
    {
      "name": "explicit-sh-invalid-keys",
      "baseEnv": {},
      "shellPath": "/bin/sh",
      "shellFile": null,
      "timeoutMs": null,
      "output": "noise\u0000__MODE_LOGIN_ENV_START__\u00001BAD=x\u0000 BAD=x\u0000=v=x\u0000OK_KEY=1\u0000__MODE_LOGIN_ENV_END__\u0000",
      "expected": {
        "resolvedShell": "/bin/sh",
        "args": [
          "-lc",
          "printf '%s\\0' '__MODE_LOGIN_ENV_START__'; env -0; printf '%s\\0' '__MODE_LOGIN_ENV_END__'"

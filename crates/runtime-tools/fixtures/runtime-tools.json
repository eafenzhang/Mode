      "expected": {
        "resolvedShell": "<root>/shell/zsh",
        "args": [
          "-ilc",
          "printf '%s\\0' '__MODE_LOGIN_ENV_START__'; env -0; printf '%s\\0' '__MODE_LOGIN_ENV_END__'"
        ],
        "options": {
          "timeout": 4000,
          "maxBuffer": 2097152,
          "env": {
            "SHELL": "<root>/shell/zsh",
            "PATH": "/usr/local/sbin;/usr/local/bin;/usr/sbin;/usr/bin;/sbin;/bin",
            "TERM": "dumb",
            "CI": "1"
          }
        },
        "captured": {
          "FROM_SHELL": "1"
        }
      }
    },
    {

{
  "cases": [
    {
      "name": "windows-default-profile-wins",
      "kind": "windows",
      "platform": "win32",
      "env": {
        "LOCALAPPDATA": "C:/Users/u/AppData/Local"
      },
      "files": {
        "C:\\Users\\u\\AppData\\Local\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json": "{\n  // comments are stripped\n  \"defaultProfile\": \"{guid-a}\",\n  \"profiles\": {\n    \"defaults\": { \"font\": { \"face\": \"Default Font\" } },\n    \"list\": [\n      { \"guid\": \"{guid-b}\", \"font\": { \"face\": \"List Font\" } },\n      { \"guid\": \"{guid-a}\", \"font\": { \"face\": \" Guid Font \" }, },\n    ],\n  },\n}"
      },
      "expected": {
        "fontFamily": "Guid Font"
      }
    },
    {
      "name": "windows-preview-fallback",

      "files": {
        "C:\\Users\\u\\AppData\\Local\\Packages\\Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe\\LocalState\\settings.json": "{\"profiles\":{\"list\":[{\"guid\":\"x\",\"font\":{\"face\":\"Preview Font\"}}]}}"
      },
      "expected": {
        "fontFamily": "Preview Font"
      }

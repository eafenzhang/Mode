{
  "urls": [
    {
      "name": "adds-app-version",
      "baseUrl": "https://example.com/api/billing/balance",
      "appVersion": "2.0.0",
      "expected": "https://example.com/api/billing/balance?app_version=2.0.0"
    },
    {
      "name": "replaces-existing-app-version",
      "baseUrl": "https://example.com/api/billing?x=1&app_version=old&y=2",
      "appVersion": "1.2.3",
      "expected": "https://example.com/api/billing?x=1&app_version=1.2.3&y=2"
    },
    {
      "name": "keeps-no-query-slash",
      "baseUrl": "https://example.com",
      "appVersion": "3.0.0",
      "expected": "https://example.com/?app_version=3.0.0"
    }
  ],
  "modelIds": [
    {
      "name": "capabilities-and-fallback",
      "payload": {
        "data": {
          "balances": [
            {
              "capabilities": [
                "model:glm-5",
                "model:GLM-5",
                " other"
              ]
            },
            {
              "capabilities": [],
              "show_name": "glm-4.7"
            },
            {
              "capabilities": [
                "MODEL: GLM-4.5 "
              ]
            },
            {
              "show_name": "unknown-model"
            },
            {
              "capabilities": [
                ""
              ],
              "show_name": ""
            }
          ]
        }
      },
      "expected": [
        "GLM-5",
        "GLM-4.7",
        "GLM-4.5",
        "unknown-model"
      ]
    },
    {
      "name": "missing-data",
      "payload": {},
      "expected": []
    }
  ],
  "expiry": [

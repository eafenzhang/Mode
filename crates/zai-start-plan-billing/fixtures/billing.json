            {
              "plan_id": "p",
              "remaining_units": 1
            }
          ]
        }
      },
      "responseTime": 100,
      "now": 0,
      "expected": {
        "data": {
          "plans": [
            {
              "plan_id": "p",
              "user_plan_id": "u",
              "status": "expired",
              "ends_at": 100
            }
          ],
          "balances": []
        }
      }
    },
    {

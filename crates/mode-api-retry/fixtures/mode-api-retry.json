      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 3,
          "maxRetries": 3,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "delay-fallbacks",
      "hasValue": true,
      "value": {
        "attempt": 1,
        "retryDelayMs": 0,
        "delayMs": 99

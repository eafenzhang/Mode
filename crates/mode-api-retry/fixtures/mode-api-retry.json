          "maxRetries": 2,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "next-attempt",
      "hasValue": true,
      "value": {
        "nextAttempt": 5
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 4,
          "maxRetries": 4,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "zero-attempt",
      "hasValue": true,
      "value": {
        "attempt": 0,
        "nextAttempt": 5
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 4,
          "maxRetries": 4,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {

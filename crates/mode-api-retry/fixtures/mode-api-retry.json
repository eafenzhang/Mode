      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 1,
          "maxRetries": 1,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "status-and-error-fallbacks",
      "hasValue": true,
      "value": {
        "attempt": 1,
        "errorStatus": 429,
        "statusCode": 500,
        "error": "e",
        "message": "m"
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 1,
          "maxRetries": 1,
          "retryDelayMs": 0,
          "errorStatus": 429,
          "error": "e"
        }
      }
    },
    {
      "name": "reason",
      "hasValue": true,
      "value": {
        "attempt": 1,
        "reason": "r"

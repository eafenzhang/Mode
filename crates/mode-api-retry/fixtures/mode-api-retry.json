  "stream": [
    {
      "name": "undefined",
      "hasValue": false,
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "null",
      "hasValue": true,
      "value": null,
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "empty",
      "hasValue": true,
      "value": {},
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "zero",
      "hasValue": true,
      "value": {

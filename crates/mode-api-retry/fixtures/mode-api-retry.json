      },
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "one",
      "hasValue": true,
      "value": {
        "retryNumber": 1
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 1,
          "maxRetries": 1,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model stream recovery retry started"
        }
      }
    },
    {
      "name": "with-max",
      "hasValue": true,
      "value": {
        "retryNumber": 3,
        "maxRetries": 2
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 3,
          "maxRetries": 3,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model stream recovery retry started"
        }
      }
    },
    {
      "name": "message",
      "hasValue": true,
      "value": {
        "retryNumber": 2,
        "maxRetries": 5,
        "message": "m"
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 2,
          "maxRetries": 5,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "m"
        }
      }
    },
    {
      "name": "fraction",
      "hasValue": true,
      "value": {
        "retryNumber": 1.5
      },
      "expected": {
        "kind": "undefined"
      }
    }
  ],
  "network": [
    {
      "name": "retry-scheduled",
      "payload": {
        "type": "model_retry_scheduled",
        "attempt": 2,
        "maxAttempts": 4,
        "error": "x"
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 2,
          "maxRetries": 3,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "x"
        }
      }
    },
    {
      "name": "retry-scheduled-next",
      "payload": {
        "type": "model_retry_scheduled",
        "nextAttempt": 5
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 4,
          "maxRetries": 4,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "request-started-first",
      "payload": {
        "type": "model_request_started",
        "attempt": 1
      },
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "request-started-retry",
      "payload": {
        "type": "model_request_started",
        "attempt": 3
      },
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "request-started-stream",
      "payload": {
        "type": "model_request_started",
        "attempt": 1,
        "streamRecovery": {
          "retryNumber": 2
        }
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 2,
          "maxRetries": 2,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model stream recovery retry started"
        }
      }
    },
    {
      "name": "request-completed",
      "payload": {
        "type": "model_request_completed"
      },
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "failed-permanent",
      "payload": {
        "type": "model_request_failed",
        "retryable": false
      },
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "failed-retryable",
      "payload": {
        "type": "model_request_failed",
        "retryable": true
      },
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "unknown-type",
      "payload": {
        "type": "other"
      },
      "expected": {
        "kind": "undefined"
      }
    }

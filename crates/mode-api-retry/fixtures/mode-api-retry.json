      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 1,
          "maxRetries": 1,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "r"
        }
      }
    },
    {
      "name": "invalid-numbers",
      "hasValue": true,
      "value": {
        "attempt": 1.5,
        "nextAttempt": 4,
        "maxRetries": -1,
        "maxAttempts": 2.5,
        "errorStatus": -1,
        "statusCode": 503,
        "message": "m"
      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 3,
          "maxRetries": 3,
          "retryDelayMs": 0,
          "errorStatus": 503,
          "error": "m"
        }
      }
    }

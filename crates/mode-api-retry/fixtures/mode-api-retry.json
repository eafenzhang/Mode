      },
      "expected": {
        "kind": "status",
        "status": {
          "kind": "api_retry",
          "attempt": 2,
          "maxRetries": 3,
          "retryDelayMs": 0,
          "errorStatus": null,
          "error": "Model retry scheduled"
        }
      }
    },
    {
      "name": "max-retries-below-attempt",
      "hasValue": true,
      "value": {
        "attempt": 3,
        "maxRetries": 1

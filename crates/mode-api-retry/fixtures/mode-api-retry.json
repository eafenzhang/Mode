      "hasValue": false,
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "null",
      "hasValue": true,
      "value": null,
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "empty-object",
      "hasValue": true,
      "value": {},
      "expected": {
        "kind": "undefined"
      }
    },
    {
      "name": "array",
      "hasValue": true,

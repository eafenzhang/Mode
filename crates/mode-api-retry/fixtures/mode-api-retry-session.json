{
  "tracker": [
    {
      "name": "direct-api-retry-then-clear-on-complete",
      "target": {
        "workspacePath": "/ws/a",
        "sessionId": "s1"
      },
      "steps": [
        {
          "kind": "event",
          "event": {
            "type": "session.event",
            "event": {
              "type": "session.updated",
              "sessionId": "s1",
              "payload": {
                "apiRetry": {
                  "attempt": 2,
                  "maxAttempts": 4,
                  "error": "e"
                }
              }
            }
          },
          "expected": {
            "type": "session.event",
            "event": {
              "type": "session.updated",
              "sessionId": "s1",
              "payload": {
                "apiRetry": {
                  "attempt": 2,
                  "maxAttempts": 4,
                  "error": "e"
                }
              }
            }
          }
        },
        {
          "kind": "snapshot",
          "snapshot": {
            "session": {
              "sessionId": "s1",
              "status": "running",
              "workspace": {
                "workspacePath": "/ws/a"
              }
            }
          },
          "expected": {
            "session": {
              "sessionId": "s1",
              "status": "running",
              "workspace": {
                "workspacePath": "/ws/a"
              }
            },
            "runtime": {
              "apiRetry": {
                "kind": "api_retry",
                "attempt": 2,
                "maxRetries": 3,
                "retryDelayMs": 0,
                "errorStatus": null,
                "error": "e"
              }
            }
          }
        },
        {
          "kind": "snapshot",
          "snapshot": {
            "session": {
              "sessionId": "s1",
              "status": "completed",
              "workspace": {
                "workspacePath": "/ws/a"
              }
            }
          },
          "expected": {
            "session": {
              "sessionId": "s1",
              "status": "completed",
              "workspace": {
                "workspacePath": "/ws/a"
              }
            },
            "runtime": {
              "apiRetry": null
            }
          }
        }
      ]
    },

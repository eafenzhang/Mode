    {
      "name": "comspec-trim-and-case-insensitive",
      "platform": "win32",
      "env": {
        "COMSPEC": "  C:\\Windows\\System32\\cmd.exe  ",
        "Path": "",
        "Pathext": ""
      },
      "existing": [],
      "expected": [
        {
          "dialect": "cmd",
          "id": "cmd:C:\\Windows\\System32\\cmd.exe",
          "label": "CMD",
          "path": "C:\\Windows\\System32\\cmd.exe",
          "source": "system"
        }
      ]

    {
      "name": "fixed-git-bash-system",
      "platform": "win32",
      "env": {
        "ComSpec": "cmd.exe"
      },
      "existing": [
        "C:\\Program Files\\Git\\bin\\bash.exe"
      ],
      "expected": [
        {
          "dialect": "cmd",
          "id": "cmd:cmd.exe",
          "label": "CMD",
          "path": "cmd.exe",
          "source": "system"
        },
        {
          "dialect": "git-bash",
          "id": "git-bash:C:\\Program Files\\Git\\bin\\bash.exe",
          "label": "Git Bash",
          "path": "C:\\Program Files\\Git\\bin\\bash.exe",
          "source": "system"
        }
      ]
    },
    {
      "name": "git-from-path-first-inference",
      "platform": "win32",
      "env": {
        "ComSpec": "C:\\Windows\\cmd.exe",
        "PATH": "C:\\Tools\\Git\\cmd;C:\\Other",
        "PATHEXT": ".EXE;.CMD"
      },
      "existing": [
        "C:\\Tools\\Git\\cmd\\git.exe",
        "C:\\Tools\\Git\\bin\\bash.exe"
      ],
      "expected": [
        {
          "dialect": "cmd",
          "id": "cmd:C:\\Windows\\cmd.exe",
          "label": "CMD",
          "path": "C:\\Windows\\cmd.exe",
          "source": "system"
        },
        {
          "dialect": "git-bash",
          "id": "git-bash:C:\\Tools\\Git\\bin\\bash.exe",
          "label": "Git Bash",
          "path": "C:\\Tools\\Git\\bin\\bash.exe",
          "source": "path"
        }
      ]
    },

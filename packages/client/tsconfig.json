{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["src"],
  // client 直接依赖 rpc/remote-core，如果不显式引用 project，typecheck 会顺着 workspace
  // 包入口重新编译源码；补 references 后优先读取已生成的声明文件。
  "references": [
    { "path": "../services" },
    { "path": "../rpc" },
    { "path": "../remote-core" }
  ]
}

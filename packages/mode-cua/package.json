{
  "name": "@mode/cua",
  "version": "0.6.3",
  "private": true,
  "description": "Computer Use host package: broker line protocol plus helper child process and Rust addon (UIA3/GDI/SendInput) for the Windows first phase, with the runtime in the node_repl host; macOS surfaces are fail-closed placeholders.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./frame-contract": {
      "types": "./frame-contract.d.ts",
      "import": "./frame-contract.js"
    },
    "./host-display-contract": {
      "types": "./host-display-contract.d.ts",
      "import": "./host-display-contract.js"
    },
    "./request-access-contract": {
      "types": "./request-access-contract.d.ts",
      "import": "./request-access-contract.js"
    },
    "./pip-session": {
      "types": "./pip-session.d.ts",
      "import": "./pip-session.js"
    },
    "./pip-session/node": {
      "types": "./pip-session-node.d.ts",
      "import": "./pip-session-node.js"
    },
    "./broker": {
      "types": "./broker.d.ts",
      "import": "./broker.js"
    },
    "./broker/server": {
      "types": "./broker-server.d.ts",
      "import": "./broker-server.js"
    },
    "./broker/ports": {
      "types": "./broker-ports.d.ts",
      "import": "./broker-ports.js"
    },
    "./broker/socketPath": {
      "types": "./broker-socket-path.d.ts",
      "import": "./broker-socket-path.js"
    },
    "./broker/helperConstants": {
      "types": "./broker-helper-constants.d.ts",
      "import": "./broker-helper-constants.js"
    },
    "./broker/helperHealth": {
      "types": "./broker-helper-health.d.ts",
      "import": "./broker-helper-health.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration.helper.test.mjs"
  },
  "modeCuaRuntime": {
    "schema": 1,
    "windows": {
      "entry": "dist-cua-helper/entry.cjs",
      "nativeAddon": "dist-cua-helper/cua_ax.node"
    }
  }
}

{
  "name": "mode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @mode/server dev\" \"pnpm --filter @mode/web dev\"",
    "dev:desktop": "pnpm --filter @mode/desktop-tauri run tauri:dev",
    "dev:server": "pnpm --filter @mode/server dev",
    "prepare": "husky",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "verify:pre-push": "pnpm run lint && node scripts/check-language-policy.mjs && pnpm run check:sqlite-schema && pnpm run architecture:check -- --changed",
    "check:upstream-overlap": "tsx scripts/upstream-overlap-check.ts",
    "check:rust-ledger": "tsx scripts/rust-ledger-gap.ts",
    "check:cli": "pnpm --dir apps/mode-cli check",
    "check:sqlite-schema": "tsx scripts/check-sqlite-schema.ts",
    "sqlite-schema:update": "tsx scripts/check-sqlite-schema.ts --update",
    "measure:host-startup": "tsx scripts/measure-host-startup.ts",
    "rpc-wire:fixtures": "tsx scripts/generate-rpc-wire-fixtures.ts",
    "settings:fixtures": "tsx scripts/generate-settings-fixtures.ts",
    "credential:fixtures": "tsx scripts/generate-credential-fixtures.ts",
    "file:fixtures": "tsx scripts/generate-file-fixtures.ts",
    "commands:fixtures": "tsx scripts/generate-commands-fixtures.ts",
    "verify:self-developed": "tsx scripts/upstream-overlap-check.ts --strict",
    "build": "pnpm -r build",
    "build:mode": "node scripts/build-mode.mjs",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@mode/desktop\" build",
    "build:cua-helper": "node scripts/build-cua-helper.mjs && node scripts/stage-cua-helper.mts",
    "build:plugin-host": "tsx scripts/build-plugin-host-bundle.ts",
    "stage:cua-helper": "node scripts/stage-cua-helper.mts",
    "build:sea": "pnpm --dir apps/mode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/mode-cli build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/cloud-relay packages/mode-server-cli packages/ui packages/web && tsc --noEmit -p packages/desktop/tsconfig.host-standalone.json && pnpm --filter @mode/desktop-tauri run typecheck && pnpm typecheck:renderer",
    "typecheck:renderer": "tsc --noEmit -p packages/desktop/tsconfig.renderer.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @mode/desktop prepare:remote-assets",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:cli": "pnpm --dir apps/mode-cli run release",
    "release:cli:dry": "pnpm --dir apps/mode-cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "orca:evidence": "node harness/orca-evidence/run.mjs",
    "test:agent-runtime-oracle": "tsx --test packages/desktop/tests/agent-runtime-oracle/*.test.mts"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
    }
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        ".release-it.mjs",
        "scripts/check-workspace-freshness.mjs",
        "scripts/mise-run.mjs"
      ]
    },
    "packages/desktop": {
      "entry": ["src/renderer/*.html"]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/entry-stdio.ts", "build-remote.ts"]
    },
    "packages/services": {
      "entry": ["src/index.ts", "src/storage/module.ts"]
    },
    "apps/mode-cli/packages/browser-use-plugin": {
      "entry": ["src/browser-client.ts"]
    },
    "apps/mode-cli/packages/mode-cua-plugin": {
      "entry": ["scripts/computer-use-client.mjs"]
    }
  },
  "ignore": [".agents/**", "docs/**", "packages/ui/src/components/**"]
}

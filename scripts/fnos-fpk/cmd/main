#!/bin/bash
# Mode 服务生命周期入口（fnOS fpk 契约：start/stop/status；0=成功/运行中，1=失败，3=未运行）。
# 进程所有权：本脚本通过 PID 文件唯一管理 mode --web 进程（见 docs/specs/fnos-fpk-packaging.md）。
# fnOS 若以 sh（dash）调用本脚本，source/local 等 bash 语义会全部失效：就地切换到 bash 重执行。
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi
cd "$(dirname "$0")" || exit 1
source ./lib.sh

PID_FILE="${TRIM_PKGVAR}/app.pid"
PROXY_PID_FILE="${TRIM_PKGVAR}/proxy.pid"
LOG_FILE="${TRIM_PKGVAR}/info.log"
LOG_ROTATE_MAX_BYTES=10485760
ENTRY="${TRIM_APPDEST}/bin/mode.mjs"
PROXY_ENTRY="${TRIM_APPDEST}/proxy.mjs"
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
GATEWAY_PREFIX="/app/mode"
NODE_BIN="${TRIM_APPDEST}/runtime/bin/node"
PORT="${TRIM_SERVICE_PORT:-$MODE_APP_PORT_DEFAULT}"

check_process() {
    kill -0 "$1" 2>/dev/null
}

is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

# 内置 Node 需要执行位；安装回调已补，这里再防御一次。
# target 卷属主不允许修改时，回退复制到应用数据目录（属主即运行用户）。
ensure_node_binary() {
    if [ -x "$NODE_BIN" ]; then
        return 0
    fi
    chmod 755 "$NODE_BIN" 2>/dev/null || true
    if [ -x "$NODE_BIN" ]; then
        return 0
    fi
    local alt="${TRIM_PKGVAR}/runtime/bin/node"
    if [ ! -x "$alt" ] || [ "$NODE_BIN" -nt "$alt" ]; then
        mkdir -p "$(dirname "$alt")" 2>/dev/null || return 1
        cp -f "$NODE_BIN" "$alt" 2>/dev/null || return 1
        chmod 755 "$alt" 2>/dev/null || true
    fi
    if [ -x "$alt" ]; then
        NODE_BIN="$alt"
        mode_log "using fallback node runtime: $alt"
        return 0
    fi
    return 1
}

# 工作区优先级：etc/workspace 显式配置 > 飞牛授权目录首项 > 应用数据目录下 workspace。
resolve_workspace() {
    if [ -s "${TRIM_PKGETC}/workspace" ]; then
        WORKSPACE="$(head -n 1 "${TRIM_PKGETC}/workspace" | tr -d '\r')"
    elif [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
        WORKSPACE="${TRIM_DATA_ACCESSIBLE_PATHS%%:*}"
    else
        WORKSPACE="${TRIM_PKGVAR}/workspace"
    fi
    if ! mkdir -p "$WORKSPACE" 2>/dev/null; then
        WORKSPACE="${TRIM_PKGVAR}/workspace"
        mkdir -p "$WORKSPACE" 2>/dev/null || mode_fail "工作目录不可用：${WORKSPACE}"
    fi
}

# 在线升级的回滚：.update/in-progress 存在时，把 backup 里的旧载荷原位恢复。
# 回滚同时删掉「只在新载荷里存在」的顶层项，避免新旧混合。
rollback_update() {
    local update_dir="${TRIM_APPDEST}/.update"
    local backup_dir="${update_dir}/backup"
    local entry name
    [ -d "$backup_dir" ] || return 0
    mode_log "rolling back staged update"
    for entry in "$TRIM_APPDEST"/*; do
        [ -e "$entry" ] || continue
        name="$(basename "$entry")"
        case "$name" in
        app.sock | .update) continue ;;
        esac
        [ -e "$backup_dir/$name" ] && continue
        rm -rf "$entry" 2>/dev/null || true
    done
    for entry in "$backup_dir"/*; do
        [ -e "$entry" ] || continue
        name="$(basename "$entry")"
        rm -rf "${TRIM_APPDEST:?}/$name" 2>/dev/null || true
        mv "$entry" "$TRIM_APPDEST/$name" 2>/dev/null || true
    done
    rm -f "${update_dir}/in-progress"
    rm -rf "$update_dir"
}

recover_interrupted_update() {
    if [ -f "${TRIM_APPDEST}/.update/in-progress" ]; then
        mode_log "found interrupted update marker"
        rollback_update
    fi
}

# info.log 轮转：fpk 里 Host 的 stdout/stderr 全部重定向到这一个文件，
# 长期运行会无限增长吃满数据盘。超过 10MB 时把当前文件改名为 info.log.1，
# 只保留一份归档；归档路径经 MODE_FNOS_INFO_LOG_ARCHIVE 交给服务进程，
# 日志导出可同时打包当前文件与归档。
rotate_info_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size="$(wc -c < "$LOG_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$size" ] || return 0
    if [ "$size" -lt "$LOG_ROTATE_MAX_BYTES" ]; then
        return 0
    fi
    rm -f "${LOG_FILE}.1" 2>/dev/null || true
    mv "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || return 0
    mode_log "rotated info.log (${size} bytes) -> ${LOG_FILE}.1"
}

start_process() {
    local allow_update_recovery="${1:-1}"
    if is_running; then
        return 0
    fi
    rotate_info_log
    recover_interrupted_update
    [ -f "$ENTRY" ] || mode_fail "缺少入口文件：${ENTRY}"
    ensure_node_binary || mode_fail "内置 Node 运行时不可用：${NODE_BIN}"

    # 预检：内置 Node 必须真的能执行（覆盖 target 卷 noexec、执行位缺失且无法改属主等场景）。
    # 首选失败时强制复制到应用数据目录再试一次——副本属主就是运行用户，chmod/执行都不受 target 卷限制。
    local node_check alt alt_check
    if ! node_check="$("$NODE_BIN" --version 2>&1)"; then
        alt="${TRIM_PKGVAR}/runtime/bin/node"
        mkdir -p "$(dirname "$alt")" 2>/dev/null || true
        cp -f "$NODE_BIN" "$alt" 2>/dev/null || true
        chmod 755 "$alt" 2>/dev/null || true
        if alt_check="$("$alt" --version 2>&1)"; then
            NODE_BIN="$alt"
            node_check="$alt_check"
        else
            mode_fail "内置 Node 无法执行（${NODE_BIN}）：${node_check}；回退副本 ${alt} 同样失败：${alt_check:-无输出}"
        fi
    fi
    mode_log "node runtime: ${node_check} (${NODE_BIN})"

    local token secret
    token="$(mode_ensure_token)" || mode_fail "无法生成访问令牌"
    secret="$(mode_ensure_credential_secret)" || mode_fail "无法生成凭据密钥"
    resolve_workspace
    mode_patch_ui_config "$token" || mode_log "WARN: ui 入口令牌写入失败（不影响服务启动，可看 etc/access-url.txt）"

    local cmd
    cmd="exec \"${NODE_BIN}\" \"${ENTRY}\" --web --host 0.0.0.0 --port ${PORT} --token \"${token}\" --workspace \"${WORKSPACE}\" --no-open"
    local home_dir="${TRIM_PKGHOME:-$HOME}"
    local run_path="${TRIM_APPDEST}/runtime/bin:${PATH}"

    mode_log "starting: port=${PORT} workspace=${WORKSPACE} node=${NODE_BIN}"
    # 脚本以 root 运行时降权到专用应用用户；正常情况 fnOS 已按 run-as=package 执行本脚本。
    if [ "$(id -u)" = "0" ] && command -v runuser >/dev/null 2>&1 && [ -n "${TRIM_USERNAME:-}" ]; then
        runuser -u "${TRIM_USERNAME}" -- env \
            MODE_DATA_BASE_DIR="${TRIM_PKGVAR}" \
            MODE_CREDENTIAL_SECRET="${secret}" \
            MODE_FNOS_UPDATE=1 \
            MODE_FNOS_APPDEST="${TRIM_APPDEST}" \
            MODE_FNOS_MAIN_SCRIPT="${PWD}/main" \
            MODE_FNOS_INFO_LOG="${LOG_FILE}" \
            MODE_FNOS_INFO_LOG_ARCHIVE="${LOG_FILE}.1" \
            MODE_FNOS_UPDATE_PUBLIC_KEY="$(cat "${TRIM_PKGETC}/update-public-key" 2>/dev/null)" \
            TRIM_APPDEST="${TRIM_APPDEST}" \
            TRIM_PKGVAR="${TRIM_PKGVAR}" \
            TRIM_PKGETC="${TRIM_PKGETC}" \
            TRIM_PKGHOME="${home_dir}" \
            TRIM_SERVICE_PORT="${PORT}" \
            TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}" \
            TRIM_USERNAME="${TRIM_USERNAME:-}" \
            TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-}" \
            HOME="${home_dir}" \
            PATH="${run_path}" \
            bash -c "${cmd}" >> "$LOG_FILE" 2>&1 &
    else
        MODE_DATA_BASE_DIR="${TRIM_PKGVAR}" \
        MODE_CREDENTIAL_SECRET="${secret}" \
        MODE_FNOS_UPDATE=1 \
        MODE_FNOS_APPDEST="${TRIM_APPDEST}" \
        MODE_FNOS_MAIN_SCRIPT="${PWD}/main" \
        MODE_FNOS_INFO_LOG="${LOG_FILE}" \
        MODE_FNOS_INFO_LOG_ARCHIVE="${LOG_FILE}.1" \
        MODE_FNOS_UPDATE_PUBLIC_KEY="$(cat "${TRIM_PKGETC}/update-public-key" 2>/dev/null)" \
        TRIM_APPDEST="${TRIM_APPDEST}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        TRIM_PKGETC="${TRIM_PKGETC}" \
        TRIM_PKGHOME="${home_dir}" \
        TRIM_SERVICE_PORT="${PORT}" \
        TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}" \
        TRIM_USERNAME="${TRIM_USERNAME:-}" \
        TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-}" \
        HOME="${home_dir}" \
        PATH="${run_path}" \
            bash -c "${cmd}" >> "$LOG_FILE" 2>&1 &
    fi
    local pid=$!
    printf '%s' "$pid" > "$PID_FILE"
    sleep 1
    if ! check_process "$pid"; then
        rm -f "$PID_FILE"
        # 新载荷起不来时优先回滚到 update/backup；回滚成功再重试一次启动，
        # 避免一次坏包把应用中心里的应用变成永久不可用。
        if [ "$allow_update_recovery" = "1" ] && [ -d "${TRIM_APPDEST}/.update/backup" ]; then
            mode_log "new payload failed to start; recovering previous payload"
            rollback_update
            start_process 0
            return $?
        fi
        # 把日志尾部写进用户可见渠道（应用中心展示的失败提示），避免只留一个用户不好找的日志路径。
        if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
            {
                printf 'Mode 启动失败。最近日志（%s）：\n' "$LOG_FILE"
                tail -n 30 "$LOG_FILE" 2>/dev/null
            } >> "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
        fi
        mode_fail "Mode 启动失败，请查看日志：${LOG_FILE}"
    fi
    mode_log "started pid=${pid}"
    # 新载荷已经成功起来，升级备份不再需要；仅清理 .update，不动 app.sock。
    rm -rf "${TRIM_APPDEST}/.update"
    start_gateway_proxy
}

# 统一网关代理：在 target 卷内监听 app.sock，供 fnOS 桌面入口（同源 iframe）访问。
# 代理失败不致命：LAN 直连 3030 端口仍然可用，只记 WARN。
start_gateway_proxy() {
    if [ ! -f "$PROXY_ENTRY" ]; then
        mode_log "WARN: 缺少 proxy.mjs，跳过统一网关接入（LAN 直连不受影响）"
        return 0
    fi
    MODE_FNOS_SOCKET="$GATEWAY_SOCKET" \
    MODE_FNOS_TARGET_PORT="$PORT" \
    MODE_FNOS_PREFIX="$GATEWAY_PREFIX" \
    MODE_FNOS_TOKEN_FILE="$(mode_token_file)" \
        bash -c "exec \"${NODE_BIN}\" \"${PROXY_ENTRY}\"" >> "$LOG_FILE" 2>&1 &
    local proxy_pid=$!
    printf '%s' "$proxy_pid" > "$PROXY_PID_FILE"
    sleep 1
    if check_process "$proxy_pid"; then
        mode_log "gateway proxy started pid=${proxy_pid} socket=${GATEWAY_SOCKET}"
    else
        rm -f "$PROXY_PID_FILE"
        mode_log "WARN: 统一网关代理启动失败（LAN 直连不受影响；详见上方日志）"
    fi
}

# 通用停止：SIGTERM → 10 秒 → SIGKILL，清 PID 文件。
stop_pidfile() {
    local pidfile="$1" label="$2" pid count
    [ -f "$pidfile" ] || return 0
    pid="$(head -n 1 "$pidfile" | tr -d '[:space:]')"
    if [ -z "$pid" ] || ! check_process "$pid"; then
        rm -f "$pidfile"
        return 0
    fi
    mode_log "stopping ${label} pid=${pid}"
    kill -TERM "$pid" 2>/dev/null || true
    count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "$pid"; then
        mode_log "SIGKILL ${label} pid=${pid}"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi
    rm -f "$pidfile"
}

stop_process() {
    stop_pidfile "$PID_FILE" "mode"
    stop_pidfile "$PROXY_PID_FILE" "gateway-proxy"
    # runuser 包装场景的兜底：子进程若残留在同一入口文件上，按路径定向清理。
    pkill -TERM -f "${ENTRY}" 2>/dev/null || true
    rm -f "$GATEWAY_SOCKET"
    mode_log "stopped"
}

case "$1" in
start)
    start_process
    ;;
restart)
    # 在线升级交换完载荷后由服务进程 detach 调用；stop 会结束当前 runner/proxy，
    # start 重新用新载荷拉起，PID 仍由本脚本唯一写入。
    stop_process
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if is_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
exit 0

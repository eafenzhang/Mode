{
  "name": "@mode/desktop-tauri",
  "version": "0.0.1",
  "private": true,
  "description": "Mode 桌面端 Tauri v2 壳（M1 骨架）。平台命令面规格见 docs/specs/tauri-platform-commands.md。",
  "scripts": {
    "build:frontend": "vite build",
    "build:frontend-for-tauri": "node --import tsx scripts/build-renderer-for-tauri.ts --no-bench",
    "build:frontend-with-bench": "node --import tsx scripts/build-renderer-for-tauri.ts",
    "build:host-sidecar": "node --import tsx scripts/build-host-sidecar.ts",
    "build:package-inputs": "node --import tsx scripts/build-renderer-for-tauri.ts --no-bench && node --import tsx scripts/build-host-sidecar.ts --stage",
    "measure:installer-budgets": "node --import tsx scripts/measure-installer-budgets.ts",
    "measure:cold-start": "node --import tsx scripts/measure-cold-start.ts",
    "dev:frontend": "vite",
    "build:rust": "cargo build -p mode-tauri",
    "test:rust": "cargo test -p platform -p protocol -p deeplink -p tray -p updater -p tauri-test-manifest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri:build": "cargo tauri build",
    "test": "node --import tsx --test test/*.test.mts"
  },
  "devDependencies": {
    "@mode/rpc": "workspace:*",
    "@tauri-apps/cli": "^2",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "@mode/ui": "workspace:*"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode",
  "version": "0.0.1",
  "identifier": "dev.mode.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mode",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        {
          "schemes": [
            "mode"
          ]
        }
      ]
    }
  }
}

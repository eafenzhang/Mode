{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode",
  "version": "0.0.1",
  "identifier": "dev.mode.app",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @mode/desktop-tauri run build:frontend-for-tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        {
          "schemes": [
            "mode"
          ]
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/eafenzhang/Mode/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}

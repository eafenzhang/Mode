{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tutto",
  "version": "0.0.1",
  "identifier": "dev.tutto.app",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @mode/desktop-tauri run build:package-inputs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist-host-sidecar/ship/host-sidecar": "host-sidecar",
      "../dist-host-sidecar/ship/node": "node",
      "../dist-host-sidecar/ship/config": "config"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        {
          "schemes": [
            "tutto",
            "mode"
          ]
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/eafenzhang/Mode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RjUxNjBCMkRFRThCQkYKUldTL2krNHRDeGIxS0QrUGUzS1IrZ0ZtZDFLTmoybXJlZjl0Z0U5Si8vb2s3K0VtbThrck0xU3MK"
    }
  }
}
